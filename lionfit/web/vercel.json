{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
