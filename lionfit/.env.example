# LionFit environment configuration — TEMPLATE
#
# Copy to .env and fill in real values. .env is gitignored; this file is not.
#   cp .env.example .env
#
# These are read at build time via --dart-define-from-file=.env, e.g.
#   flutter run -d chrome --dart-define-from-file=.env
#   flutter build web   --dart-define-from-file=.env
#
# Dart reads them with String.fromEnvironment(...) — see lib/core/config/env.dart.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Hosted project: Dashboard -> Project Settings -> API
# Local stack:    `supabase start` prints both values
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NEVER put the service_role key here. It bypasses Row Level Security and this
# file is consumed by a client build that ships to the browser. Server-only
# secrets belong in Supabase Edge Function secrets:
#   supabase secrets set FITBIT_CLIENT_SECRET=...

# ---------------------------------------------------------------------------
# Auth / seeding (local development only)
# ---------------------------------------------------------------------------
# DECIDED: email + password auth (not username login). Pao is an ADMIN.
# See CLAUDE.md -> Auth model.
#
# Set SEED_USER_EMAIL to a real address you control if you leave email
# confirmation enabled; otherwise the account cannot log in until confirmed.
SEED_USER_EMAIL=pao@selu.edu
SEED_USER_DISPLAY_NAME=Pao
SEED_USER_PASSWORD=superAdmin
SEED_USER_ROLE=admin

# `superAdmin` is a development-only credential. It must never be the password
# on a deployed or publicly reachable instance.

# ---------------------------------------------------------------------------
# Fitbit (optional — the app must work without it)
# ---------------------------------------------------------------------------
# Register at https://dev.fitbit.com/apps. Only the client ID is safe here;
# the client secret lives in an Edge Function secret, never in the client.
FITBIT_CLIENT_ID=
FITBIT_REDIRECT_URI=http://localhost:3000/auth/fitbit/callback

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
